PORT=4000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ploce_kolekcija
# Potrebno samo za hostovane baze koje zahtijevaju SSL (npr. Aiven) — sadržaj CA sertifikata (ca.pem)
DB_CA_CERT=

# Porijeklo sa kojih frontend smije da zove ovaj API (odvojeno zarezom)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Nasumičan, dovoljno dug string — npr: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Opciono: lični Discogs token (discogs.com/settings/developers → Generate token).
# Bez njega uvoz radi, ali pretraga nema sličice i limit je 25 zahtjeva/min umjesto 60.
DISCOGS_TOKEN=

# Cloudinary — čuvanje omota (Dashboard → API environment variable)
CLOUDINARY_URL=
# Folder u Cloudinary-ju u koji idu omoti (npr. ploce-dev lokalno, ploce u produkciji)
CLOUDINARY_FOLDER=ploce
